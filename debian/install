# Install the main Python script as the executable
atrTrailingStop/main.py                  usr/bin/pacechaser

# Install required Python modules
atrTrailingStop/utils.py                 usr/share/pacechaser/
atrTrailingStop/orders.py                usr/share/pacechaser/
atrTrailingStop/ibkr_api.py              usr/share/pacechaser/
atrTrailingStop/calculator.py            usr/share/pacechaser/
atrTrailingStop/atr_processor.py         usr/share/pacechaser/

# Install JSON data files
atrTrailingStop/user_settings.json       usr/share/pacechaser/
atrTrailingStop/tr_history.json          usr/share/pacechaser/
atrTrailingStop/stop_history.json        usr/share/pacechaser/
atrTrailingStop/atr_history.json         usr/share/pacechaser/

